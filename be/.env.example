TELLPAL_DB_URL=jdbc:postgresql://localhost:5432/tellpal_v2
TELLPAL_DB_NAME=tellpal_v2
TELLPAL_DB_PORT=5432
TELLPAL_DB_USERNAME=tellpal
TELLPAL_DB_PASSWORD=tellpal
TELLPAL_DB_MAX_POOL_SIZE=10
TELLPAL_DB_MIN_IDLE=2
TELLPAL_ASSET_PROCESSING_POLLER_ENABLED=true
TELLPAL_ASSET_PROCESSING_POLLER_DELAY_MS=5000
TELLPAL_ASSET_PROCESSING_POLLER_BATCH_SIZE=10
TELLPAL_ASSET_STORAGE_FIREBASE_PROJECT_ID=
TELLPAL_ASSET_STORAGE_FIREBASE_BUCKET_NAME=
# Host path used only by Docker Compose; do not commit the credential file.
TELLPAL_ASSET_STORAGE_FIREBASE_CREDENTIALS_HOST_PATH=
# Container path. The Compose bind mount defaults to this value.
TELLPAL_ASSET_STORAGE_FIREBASE_CREDENTIALS_PATH=/run/secrets/tellpal-firebase-storage-pk.json
TELLPAL_ASSET_STORAGE_FIREBASE_PATH_PREFIX=local
TELLPAL_REVENUECAT_AUTHORIZATION_HEADER=

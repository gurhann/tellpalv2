+class _ScopedRunPhaseAndroid(_RunPhaseAndroid):
+    def write_configuration(self, value, timeout=3):
+        # Controller belleğini temizlemeden önce teslim edilen payload'ı sabitle.
+        self.configuration = copy.deepcopy(value)
